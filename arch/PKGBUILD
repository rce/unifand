# Maintainer: Your Name <your@email.com>
pkgname=unifand
pkgver=0.1.0
pkgrel=1
maintainer="Henry Heikkinen <rce@rce.fi>"
url=https://github.com/rce/unifand
pkgdesc='Control utility for Lian Li Uni fans and wireless LCD displays'
arch=('x86_64')
license=('MIT')
depends=('hidapi' 'libusb')
makedepends=('cargo')
install=unifand.install
options=(!lto)
_rootdir="$startdir/.."

prepare() {
  cd "$_rootdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_rootdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$_rootdir"
  install -Dm755 target/release/unifanctl "$pkgdir/usr/bin/unifanctl"
  install -Dm644 60-unifand.rules "$pkgdir/usr/lib/udev/rules.d/60-unifand.rules"
}
